# ──────────────────────────────────────────────
# VXID Backend Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# Database (Railway PostgreSQL plugin auto-injects this in production)
DATABASE_URL="postgresql://user:password@localhost:5432/vxid?schema=public"

# Server
PORT=8080
NODE_ENV=production

# JWT (min 64-char random string — generate with: openssl rand -base64 48)
JWT_SECRET="replace-with-a-64-char-random-string"

# CORS — the frontend origin (lock down in production)
FRONTEND_URL=https://your-frontend.railway.app

# SMTP (Gmail App Password — NOT your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# Admin notification recipient
ADMIN_EMAIL=admin@vxid.studio

# Seed admin credentials (used by `npm run seed`)
ADMIN_SEED_EMAIL=admin@vxid.studio
ADMIN_SEED_PASSWORD=change-this-password
